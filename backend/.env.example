# Postgres connection (async driver required - postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://localhost/ats_checker

# Which AI engine (Engine 2) to use for semantic analysis: ollama | openai | anthropic
# "ollama" is the default and needs no API key - the app is fully functional
# with it alone. If the selected provider fails or isn't configured, analysis
# falls back to the rule engine (Engine 1) alone rather than failing the request.
AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

MAX_UPLOAD_SIZE_BYTES=5242880

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]
