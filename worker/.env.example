# Same shape as backend/.env.example - the worker reads the same Settings
# class (backend/app/core/config.py), since it needs the same DB and AI
# provider configuration to run the analysis pipeline.

DATABASE_URL=postgresql+asyncpg://localhost/ats_checker

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# How often (seconds) the worker polls for pending jobs when idle.
WORKER_POLL_INTERVAL_SECONDS=3
