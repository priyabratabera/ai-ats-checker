# Optional. The FastAPI backend (../backend) - deterministic PyMuPDF-based
# rule engine + pluggable Ollama/OpenAI/Claude semantic engine + Postgres
# persistence. When reachable, /api/analyze proxies to it and its result is
# authoritative. When unreachable (not running, network error, timeout),
# /api/analyze automatically falls back to this app's own self-contained
# TypeScript analysis engine - the app is fully functional either way.
BACKEND_API_URL=http://localhost:8000

# Optional. Only used by the local TS fallback engine (when the backend
# above is unreachable) for richer semantic gap analysis instead of the
# built-in heuristic summary.
ANTHROPIC_API_KEY=
